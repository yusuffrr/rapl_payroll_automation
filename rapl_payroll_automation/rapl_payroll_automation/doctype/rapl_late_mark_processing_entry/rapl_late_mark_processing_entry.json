{
  "doctype": "DocType",
  "name": "RAPL Late Mark Processing Entry",
  "module": "RAPL Payroll Automation",
  "istable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "employee",
    "employee_name",
    "band_1_count",
    "band_2_count",
    "band_3_count",
    "band_4_count",
    "band_5_count",
    "column_break_amt",
    "per_day_rate",
    "amount",
    "waived_marks",
    "waived_amount",
    "additional_salary",
    "section_break_waiver",
    "band_1_waived",
    "band_2_waived",
    "band_3_waived",
    "band_4_waived",
    "band_5_waived",
    "column_break_waiver",
    "amount_before_waiver",
    "waiver_reason"
  ],
  "fields": [
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "fetch_from": "employee.employee_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "band_1_count",
      "fieldtype": "Int",
      "label": "Band 1",
      "default": "0",
      "in_list_view": 1,
      "description": "Count of occurrences in Late Mark Band #1 (as configured in RAPL Payroll Automation Settings). Column label is renamed at runtime to match that band's actual Label -- this generic name is only the underlying fieldname."
    },
    {
      "fieldname": "band_2_count",
      "fieldtype": "Int",
      "label": "Band 2",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "band_3_count",
      "fieldtype": "Int",
      "label": "Band 3",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "band_4_count",
      "fieldtype": "Int",
      "label": "Band 4",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "band_5_count",
      "fieldtype": "Int",
      "label": "Band 5",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_amt",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "per_day_rate",
      "fieldtype": "Currency",
      "label": "Per-Day Rate",
      "precision": "6",
      "in_list_view": 1,
      "description": "Exact per-day rate (monthly salary / calendar days), to 6 decimals. Amount = sum(count x band fraction) x this rate, rounded once to whole rupees. Editable; changing it recalculates Amount."
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount",
      "precision": "0",
      "in_list_view": 1,
      "description": "Whole rupees. Auto-recalculated as SUM(band count x that band's configured fraction) x Per-Day Rate, whenever any band count or Per-Day Rate changes. You can also edit Amount directly -- one-way, does not push a value back into the band counts."
    },
    {
      "fieldname": "additional_salary",
      "fieldtype": "Link",
      "label": "Additional Salary (after processing)",
      "no_copy": 1,
      "options": "Additional Salary",
      "read_only": 1
    },
    {
      "fieldname": "waived_marks",
      "fieldtype": "Int",
      "label": "Waived Marks",
      "read_only": 1,
      "default": "0",
      "in_list_view": 1,
      "columns": 1,
      "description": "Total late marks waived on this row (sum of the per-band waivers below)."
    },
    {
      "fieldname": "waived_amount",
      "fieldtype": "Currency",
      "label": "Waived Amount",
      "precision": "0",
      "read_only": 1,
      "in_list_view": 1,
      "description": "Amount Before Waiver minus Amount: the deduction forgiven."
    },
    {
      "fieldname": "section_break_waiver",
      "fieldtype": "Section Break",
      "label": "Late Mark Waiver",
      "collapsible": 1,
      "collapsible_depends_on": "eval:doc.waived_marks"
    },
    {
      "fieldname": "band_1_waived",
      "fieldtype": "Int",
      "label": "Waived: Band 1",
      "default": "0",
      "description": "Late marks of this band forgiven for the month. Kept between 0 and the band's own count: waiving more than the employee has stops at their count -- never a negative deduction or extra pay."
    },
    {
      "fieldname": "band_2_waived",
      "fieldtype": "Int",
      "label": "Waived: Band 2",
      "default": "0"
    },
    {
      "fieldname": "band_3_waived",
      "fieldtype": "Int",
      "label": "Waived: Band 3",
      "default": "0"
    },
    {
      "fieldname": "band_4_waived",
      "fieldtype": "Int",
      "label": "Waived: Band 4",
      "default": "0"
    },
    {
      "fieldname": "band_5_waived",
      "fieldtype": "Int",
      "label": "Waived: Band 5",
      "default": "0"
    },
    {
      "fieldname": "column_break_waiver",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "amount_before_waiver",
      "fieldtype": "Currency",
      "label": "Amount Before Waiver",
      "precision": "0",
      "read_only": 1,
      "description": "What this row would deduct with no waiver: sum(count x fraction) x Per-Day Rate, rounded once."
    },
    {
      "fieldname": "waiver_reason",
      "fieldtype": "Small Text",
      "label": "Waiver Reason",
      "description": "Required whenever any marks are waived. While a waiver is on the row, Amount is always calculated from the counts minus the waived marks."
    }
  ],
  "permissions": []
}
